{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Mehen",
  "version": "0.1.0",
  "identifier": "dev.mehen.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Mehen",
        "width": 1440,
        "height": 920,
        "minWidth": 1024,
        "minHeight": 640,
        "center": true,
        "backgroundColor": "#100f0d"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyREQ1M0QzNzEyMjI0NTcKUldSWEpDSngwMVBkMGdzSmZwYlZTK0VtSStRL3pSVWdKT25ML3VjL1pmampBL04xcmozSzVjUFoK",
      "endpoints": ["https://cdn.gitwyrm.com/mehen/updates/stable.json"],
      "windows": {
        "installMode": "quiet"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": ["resources/**/*"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "installer-hooks.nsh"
      }
    }
  }
}
